    My Orders > order: "Request a return" among the order's buttons, when
    the order still has something to return (templates/order-button.phtml).
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="sales.order.info.buttons">
            <block class="Magento\Sales\Block\Order\Info" name="zero.returns.order.button" template="Zero_Returns::order-button.phtml"
                   ifconfig="zero_returns/general/enabled">
                <arguments>
                    <argument name="viewModel" xsi:type="object">Zero\Returns\ViewModel\Storefront</argument>
                </arguments>
            </block>
        </referenceBlock>
    </body>
</page>
